# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development

# Supabase Supavisor pooler, transaction mode (port 6543). Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: session-mode (5432) or direct URL for Alembic migrations. Falls back to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DB_ECHO=false

# Supabase Auth: verify user JWTs. Set the JWT secret for HS256-signed tokens
# (Project Settings > API), and/or SUPABASE_URL for asymmetric (ES256/RS256)
# signing keys, which are verified against the project's JWKS.
SUPABASE_JWT_SECRET=<jwt-secret>
# SUPABASE_URL=https://<project-ref>.supabase.co

# JSON list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000"]

# RabbitMQ (CloudAMQP gives an amqps:// URL; local: amqp://guest:guest@localhost:5672/)
RABBITMQ_URL=amqps://<user>:<password>@<host>/<vhost>

# Unacked messages each worker may hold at once.
WORKER_PREFETCH_COUNT=1
